# Per-environment settings and secrets: local.env, staging.env, prod.env.
*.env
.env

# Compiled binary from `go build ./cmd/server` — regenerate with `go run`/`go build`.
/server

# Compiled Lambda artifact — regenerate with provision/build.sh
provision/build/

# Terraform local state and provider cache. staging/prod keep state in S3
# (see provision/envs/*/versions.tf); local and bootstrap keep it on this
# machine. The .lock.hcl files are NOT ignored — those are meant to be
# committed.
provision/**/.terraform/
provision/**/*.tfstate
provision/**/*.tfstate.*
provision/**/crash.log
provision/**/*.tfvars
provision/**/*.tfplan

# The FCM service-account key, for local runs (see FCM_CREDENTIAL_FILE).
# Anyone holding one can push arbitrary text to every user's lock screen.
# Matched anywhere in the name, not as a prefix: these arrive named after
# whatever project generated them.
*firebase-adminsdk*.json
*fcm*service*account*.json
*service-account*.json

# The APNs auth key, for local runs (see APNS_AUTH_KEY_FILE) — same risk
# as the FCM key above. Apple names these AuthKey_<KeyID>.p8; .p8 is used
# for nothing else in this repo.
*.p8

# One file per environment: copy to local.env, staging.env or prod.env
# (all gitignored). local.env is the whole configuration for a local run;
# staging.env/prod.env carry the first two sections only, uploaded to SSM
# by push-config.sh. Everything else a deployed relay needs comes from
# Terraform — see docs/INFRASTRUCTURE.md.

# --- Sign-in: accepted token audiences. Must match app/.env.local's
# EXPO_PUBLIC_GOOGLE_*_CLIENT_ID; blank means "not configured".
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_WEB=
APPLE_CLIENT_ID_IOS=

# --- Sign in with Apple revocation: deleting an account revokes the Apple
# grant behind it (App Store Review Guideline 5.1.1(v)). The team id is
# the same team as APNS_TEAM_ID; the key is a *different* one — a Sign in
# with Apple key, not an APNs key. Leave blank and deletion still works,
# it just leaves the grant standing.
APPLE_SIGNIN_KEY_ID=
APPLE_SIGNIN_TEAM_ID=

# --- Push: APNs identifiers, not secrets — the .p8 file is the secret.
# APNS_TOPIC is the iOS bundle id, and APNS_PRODUCTION must match
# app.json's aps-environment: a debug build only works against sandbox.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=com.eozsahin.mimoza
APNS_PRODUCTION=false

# --- Local runtime. RESOURCE_PREFIX names every table, the bucket and
# every SSM parameter; Terraform sets it in deployed environments.
# S3_FORCE_PATH_STYLE is for LocalStack only, never real AWS.
RESOURCE_PREFIX=mimoza-local

# debug | info | warn | error. Deployed environments use info.
LOG_LEVEL=debug
PORT=8080
S3_FORCE_PATH_STYLE=true

# --- LocalStack. Read by the AWS SDK, not internal/config —
# AWS_ENDPOINT_URL redirects every service call, so no code knows.
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# --- Credential files, local only: in AWS these are SSM SecureStrings
# created by hand, so their values never enter Terraform state. Keep them
# out of the repo — .gitignore already catches these names.
# FCM_CREDENTIAL_FILE=./fcm-service-account.json
# APNS_AUTH_KEY_FILE=./AuthKey_XXXXXXXXXX.p8
# APPLE_SIGNIN_KEY_FILE=./AuthKey_XXXXXXXXXX.p8

# Tuning (MAX_BLOB_SIZE_BYTES, INVITE_RETENTION_DAYS, RATE_LIMIT_*) lives
# in provision/envs/*/main.tf, and falls back to internal/config's
# defaults locally.

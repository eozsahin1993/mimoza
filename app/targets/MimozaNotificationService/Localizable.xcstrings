          "stringUnit": {
            "state": "translated",
            "value": "Hay novedades sobre tu solicitud para unirte a un círculo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Du nouveau pour ta demande pour rejoindre un cercle"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt Neuigkeiten zu deiner Anfrage, einem Kreis beizutreten"
          }

# Copy to .env.dev, .env.staging or .env.production (all gitignored) and
# fill in. Each is loaded by its own npm script — never name one .env or
# .env.local, which Expo loads on top of whatever the script passed.

# dev | staging | production — picks the bundle id, name, App Group and
# Firebase file (app.config.js). Unset means dev.
APP_ENV=dev

# `terraform output api_endpoint`. Unset for dev: the build infers the
# packager's host.
EXPO_PUBLIC_RELAY_URL=

# From this environment's Google Cloud project. Must match its relay's
# GOOGLE_CLIENT_ID_* or every token is rejected.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# true hides the corner ribbon (ui/components/env-badge.tsx) without
# pretending APP_ENV is production — for a clean local screenshot only.
EXPO_PUBLIC_HIDE_ENV_BADGE=

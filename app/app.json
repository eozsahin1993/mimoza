{
  "expo": {
    "name": "Mimoza",
    "slug": "mimoza",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mimoza",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.eozsahin.mimoza",
      "appleTeamId": "N323492Q8L",
      "usesAppleSignIn": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "CFBundleAllowMixedLocalizations": true,
        "NSPhotoLibraryUsageDescription": "Mimoza accesses your photos so you can pick the ones to share in your circles.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "aps-environment": "development",
        "com.apple.security.application-groups": [
          "group.com.eozsahin.mimoza"
        ]
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "com.eozsahin.mimoza",
      "adaptiveIcon": {
        "backgroundColor": "#14100C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "versionCode": 1
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "@bacons/apple-targets",
      "expo-router",
      "./plugins/with-splash-wordmark",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#14100C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-sqlite",
      "expo-apple-authentication",
      "@react-native-google-signin/google-signin",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Mimoza uses your camera to scan a device transfer code.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "locales": {
      "tr": "./locales/tr.json",
      "es": "./locales/es.json",
      "fr": "./locales/fr.json",
      "de": "./locales/de.json"
    }
  }
}

# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# Every env file but the template: .env.dev, .env.staging, and whatever
# comes next. Never .env or .env.local — Expo loads those itself, on top
# of the file a script passed in, so their values end up in every build.
.env*
!.env.example

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Firebase service-account keys — the relay's FCM credential. Never commit:
# anyone holding one can push arbitrary text to every user's lock screen.
# google-services.json is fine (it ships inside the APK, and its API key is
# restricted to this package and signing certificate).
# Matched anywhere in the name, not as a prefix: these arrive named after
# whatever project generated them.
*firebase-adminsdk*.json
*service-account*.json
fastlane/*.json

# JVM crash dumps, which a Gradle daemon leaves in the project root.
hs_err_pid*.log
replay_pid*.log

# Fastlane: build output and generated reports. The Fastfile, Appfile and
# Matchfile are versioned; what they produce is not.
/build
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output

# Gems install into the project rather than Homebrew's shared directory,
# which isn't writable here. The lockfile is versioned; the gems are not.
/vendor/bundle
/.bundle

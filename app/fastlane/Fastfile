require 'json'

# Here rather than ios/fastlane, where `fastlane init` puts it: ios/ is
# generated and every prebuild passes --clean.

default_platform(:ios)

ENVIRONMENTS = {
  'staging' => {
    scheme: 'MimozaStaging',
    workspace: 'ios/MimozaStaging.xcworkspace',
    app_identifier: 'com.eozsahin.mimoza.staging',
    env_file: '.env.staging',
    project: 'ios/MimozaStaging.xcodeproj',
    target: 'MimozaStaging',
    package_name: 'com.eozsahin.mimoza.staging',
    firebase_app: '1:1049240173156:android:f139763b32092d5ac97d71',
  },
  'production' => {
    scheme: 'Mimoza',
    workspace: 'ios/Mimoza.xcworkspace',
    app_identifier: 'com.eozsahin.mimoza',
    env_file: '.env.production',
    project: 'ios/Mimoza.xcodeproj',
    target: 'Mimoza',
    package_name: 'com.eozsahin.mimoza',
  },
}.freeze

before_all do
  app_store_connect_api_key if lane_context[SharedValues::PLATFORM_NAME] == :ios
  # A runner has no login keychain for match to install into.
  setup_ci if is_ci
end

platform :ios do
  desc 'Build staging and upload it to TestFlight'
  lane :staging do
    ship('staging')
  end

  desc 'Build production and upload it to TestFlight'
  lane :production do
    ship('production')
  end

  desc 'Fetch or create signing certificates and profiles for every bundle id'
  lane :certificates do
    match(
      type: 'appstore',
      app_identifier: ENVIRONMENTS.values.flat_map { |e| identifiers(e[:app_identifier]) },
      readonly: false,
    )
  end
end

platform :android do
  desc 'Build staging and upload it to Play internal testing'
  lane :staging do
    ship_android('staging')
  end

  desc 'Build production and upload it to Play internal testing'
  lane :production do
    ship_android('production')
  end
end

# The notification service extension needs its own profile, and an archive
# fails on it long after the app itself has signed.
def identifiers(app_identifier)
  [app_identifier, "#{app_identifier}.notification-service"]
end

def app_root
  File.expand_path('..', __dir__)
end

def ship(name)
  config = ENVIRONMENTS.fetch(name)

  prebuild(config[:env_file], next_build_number(config[:app_identifier]))
  # Expo skips pods when it can't find a usable CocoaPods, and the
  # workspace gym archives is CocoaPods' output, not Expo's.
  cocoapods(podfile: File.join(app_root, 'ios', 'Podfile'))

  match(
    type: 'appstore',
    app_identifier: identifiers(config[:app_identifier]),
    readonly: is_ci,
  )

  # Expo generates the project with automatic signing, which resolves fine
  # against a logged-in Xcode and finds nothing on a runner — it looks for
  # development profiles while match has installed App Store ones.
  sign_manually(config)

  # Outside Bundler: Xcode's script phases inherit BUNDLE_GEMFILE and then
  # resolve their own Ruby against vendor/bundle.
  Bundler.with_unbundled_env do
    build_app(
      workspace: File.join(app_root, config[:workspace]),
      scheme: config[:scheme],
      export_method: 'app-store',
      # match records a mapping the export step doesn't read. Without this
      # the archive succeeds and then fails with "No profiles found".
      export_options: {
        provisioningProfiles: identifiers(config[:app_identifier]).to_h do |id|
          [id, "match AppStore #{id}"]
        end,
      },
      disable_xcpretty: true,
      buildlog_path: File.join(app_root, 'build', 'logs'),
      output_directory: 'build',
    )
  end

  upload_to_testflight(
    app_identifier: config[:app_identifier],
    distribute_external: false,
    skip_waiting_for_build_processing: true,
  )
end

def ship_android(name)
  config = ENVIRONMENTS.fetch(name)

  # Gradle runs Metro, so EXPO_PUBLIC_* has to reach it too — without this
  # the bundle is built against no relay at all, and the config plugins
  # that read those vars fail the build first.
  load_env(config[:env_file])

  version_code = next_version_code(config[:package_name])
  prebuild_android(config[:env_file], version_code)

  keystore = fetch_keystore

  # APK for App Distribution, AAB for Play: App Distribution only takes a
  # bundle from an app that is linked to a Play listing, and staging has
  # none on purpose.
  #
  # Injected rather than written into build.gradle: that file is generated,
  # and --clean would drop the signing config on the next run.
  gradle(
    task: config[:firebase_app] ? 'assemble' : 'bundle',
    build_type: 'Release',
    project_dir: File.join(app_root, 'android'),
    properties: {
      'android.injected.signing.store.file' => keystore,
      'android.injected.signing.store.password' => ENV.fetch('ANDROID_KEYSTORE_PASSWORD'),
      'android.injected.signing.key.alias' => 'mimoza-upload',
      'android.injected.signing.key.password' => ENV.fetch('ANDROID_KEYSTORE_PASSWORD'),
    },
    # The properties carry the keystore password, and fastlane echoes the
    # command it runs into both the log and report.xml.
    print_command: false,
  )

  return distribute_to_testers(config) if config[:firebase_app]

  aab = lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH]
  if ENV['PLAY_JSON_KEY'].nil?
    UI.important("No PLAY_JSON_KEY — built #{aab}, upload it by hand.")
    return
  end

  upload_to_play_store(
    package_name: config[:package_name],
    track: 'internal',
    aab: aab,
    json_key: ENV.fetch('PLAY_JSON_KEY'),
    # The listing is managed in the console, not here.
    skip_upload_metadata: true,
    skip_upload_images: true,
    skip_upload_screenshots: true,
  )
end

# Testers get an email, then every later build appears in App Tester.
# Invite-only: nothing here publishes a public download link.
def distribute_to_testers(config)
  apk = lane_context[SharedValues::GRADLE_APK_OUTPUT_PATH]
  if ENV['FIREBASE_SERVICE_ACCOUNT'].nil?
    UI.important("No FIREBASE_SERVICE_ACCOUNT — built #{apk}, install it by hand.")
    return
  end

  firebase_app_distribution(
    app: config[:firebase_app],
    android_artifact_path: apk,
    groups: ENV.fetch('FIREBASE_TESTER_GROUP', 'internal'),
    release_notes: `git log -1 --pretty=%s`.strip,
    service_credentials_file: ENV.fetch('FIREBASE_SERVICE_ACCOUNT'),
  )
end

# Play rejects a repeat, and a failed upload must not burn the number — so
# ask it rather than counting locally. Staging has no Play app to ask and
# App Distribution accepts anything, so the run number stands in: builds
# there only need to be distinguishable from each other.
def next_version_code(package_name)
  return ENV['GITHUB_RUN_NUMBER'] || Time.now.to_i.to_s if ENV['PLAY_JSON_KEY'].nil?

  codes = google_play_track_version_codes(
    package_name: package_name,
    track: 'internal',
    json_key: ENV.fetch('PLAY_JSON_KEY'),
  )
  ((codes.max || 0) + 1).to_s
rescue StandardError => e
  UI.important("Could not read Play version codes (#{e.message}); starting at 1.")
  '1'
end

# The keystore lives in the certs repo; its password does not.
#
# Cloned the way match itself authenticates, so both halves of a release
# read the same repo with the same credential: an SSH url resolves against
# the agent, an https one needs the basic header a runner has instead of a
# key. Unlogged — that header is the credential.
def fetch_keystore
  dir = File.join(Dir.tmpdir, 'mimoza-certs')
  FileUtils.rm_rf(dir)

  auth = ENV['MATCH_GIT_BASIC_AUTHORIZATION']
  args = ['git']
  args += ['-c', "http.extraheader=AUTHORIZATION: basic #{auth}"] if auth
  args += ['clone', '--depth', '1', ENV.fetch('MATCH_GIT_URL'), dir]
  sh(*args, log: false)

  File.join(dir, 'android', 'mimoza-upload.jks')
end

def load_env(env_file)
  path = File.join(app_root, env_file)
  # CI has no .env files and passes the same variables directly.
  return unless File.exist?(path)

  File.readlines(path).each do |line|
    key, value = line.strip.split('=', 2)
    next if value.nil? || key.start_with?('#')

    ENV[key] = value
  end
end

def prebuild_android(env_file, build_number)
  Dir.chdir(app_root) do
    sh(
      { 'APP_BUILD_NUMBER' => build_number },
      'npx', 'dotenv', '-e', env_file, '--',
      'expo', 'prebuild', '--platform', 'android', '--clean',
    )
  end
end

# Asked of Apple rather than derived from the run: a re-run reuses
# github.run_number, so a build that failed at upload would be rejected as
# a duplicate on exactly the retry you wanted.
def next_build_number(app_identifier)
  version = JSON.parse(File.read(File.join(app_root, 'app.json')))['expo']['version']
  latest = latest_testflight_build_number(
    app_identifier: app_identifier,
    version: version,
    initial_build_number: 0,
  )
  (latest.to_i + 1).to_s
end

def sign_manually(config)
  project = File.join(app_root, config[:project])
  { config[:target] => config[:app_identifier],
    'MimozaNotificationService' => "#{config[:app_identifier]}.notification-service" }
    .each do |target, identifier|
      update_code_signing_settings(
        path: project,
        targets: [target],
        use_automatic_signing: false,
        team_id: ENV.fetch('FASTLANE_TEAM_ID'),
        bundle_identifier: identifier,
        profile_name: "match AppStore #{identifier}",
        code_sign_identity: 'Apple Distribution',
      )
    end
end

# fastlane's `sh` runs beside the Fastfile, where expo finds no
# package.json. APNS_PRODUCTION earns the production entitlement that a
# distribution profile requires and the .env files deliberately omit.
def prebuild(env_file, build_number)
  Dir.chdir(app_root) do
    sh(
      { 'APNS_PRODUCTION' => 'true', 'APP_BUILD_NUMBER' => build_number },
      'npx', 'dotenv', '-e', env_file, '--',
      'sh', '-c', 'expo prebuild --platform ios --clean && node scripts/write-xcode-env.js',
    )
  end
end

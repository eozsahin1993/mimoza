{
  "name": "mimoza",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "dependencies": {
    "@expo/ui": "~57.0.14",
    "@expo/vector-icons": "^15.0.2",
    "@formatjs/intl-pluralrules": "^6.3.15",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@scure/bip39": "^2.4.0",
    "buffer": "^6.0.3",
    "drizzle-orm": "^0.45.2",
    "emoji-regex": "^10.6.0",
    "expo": "~57.0.18",
    "expo-apple-authentication": "~57.0.1",
    "expo-application": "~57.0.3",
    "expo-camera": "~57.0.5",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.16",
    "expo-crypto": "~57.0.2",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.2",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-image-manipulator": "~57.0.14",
    "expo-image-picker": "~57.0.14",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.8",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.2",
    "expo-sharing": "~57.0.19",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-task-manager": "~57.0.16",
    "expo-updates": "~57.0.23",
    "expo-web-browser": "~57.0.2",
    "i18next": "^26.4.2",
    "lucide-react-native": "^1.43.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.14",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@expo/fingerprint": "^0.20.11",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.0",
    "@types/react": "~19.2.2",
    "babel-plugin-inline-import": "^3.0.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "expo-sqlite-mock": "^4.0.0",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "dotenv -e .env.dev -- expo start",
    "start:staging": "dotenv -e .env.staging -- expo start --clear",
    "start:prod": "dotenv -e .env.production -- expo start --clear",
    "reset-project": "node ./scripts/reset-project.js",
    "prebuild": "dotenv -e .env.dev -- sh -c 'expo prebuild --clean && node scripts/write-xcode-env.js'",
    "prebuild:staging": "dotenv -e .env.staging -- sh -c 'expo prebuild --clean && node scripts/write-xcode-env.js'",
    "prebuild:prod": "dotenv -e .env.production -- sh -c 'expo prebuild --clean && node scripts/write-xcode-env.js'",
    "android": "dotenv -e .env.dev -- expo run:android",
    "android:staging": "dotenv -e .env.staging -- expo run:android",
    "android:prod": "dotenv -e .env.production -- expo run:android",
    "ios": "dotenv -e .env.dev -- expo run:ios --device \"iPhone 17\"",
    "ios:staging": "dotenv -e .env.staging -- expo run:ios --device \"iPhone 17\"",
    "ios:prod": "dotenv -e .env.production -- expo run:ios --device \"iPhone 17\"",
    "fingerprint:dev": "dotenv -e .env.dev -- fingerprint fingerprint:generate",
    "fingerprint:staging": "dotenv -e .env.staging -- fingerprint fingerprint:generate",
    "fingerprint:prod": "dotenv -e .env.production -- fingerprint fingerprint:generate",
    "lint": "expo lint",
    "test": "fnm exec --using=22.23.2 -- jest",
    "db:generate": "drizzle-kit generate",
    "i18n:push": "node scripts/generate-push-strings.js"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.js"
    ],
    "setupFilesAfterEnv": [
      "expo-sqlite-mock/src/setup.ts"
    ],
    "moduleNameMapper": {
      "^lucide-react-native/icons/(.*)$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/icons/$1.js"
    },
    "testTimeout": 10000,
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|@noble|@scure|@formatjs))"
    ]
  }
}
